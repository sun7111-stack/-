# 复制为 .env 后再按服务器情况修改：
# cp .env.docker.example .env

DB_NAME=carbon_platform
DB_USER=carbon
DB_PASSWORD=carbon_password
MYSQL_ROOT_PASSWORD=carbon_root_password

FRONTEND_PORT=5500
BACKEND_PORT=8000
MYSQL_PORT=3306

JWT_SECRET_KEY=please-change-this-jwt-secret-in-production
APP_DEBUG=false

# 若前端通过域名访问，可把域名加进来；Nginx 同源 /api 访问通常不依赖 CORS。
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# 真实 OCR/VLM/报告模型需要配置通义千问 DashScope Key。
DASHSCOPE_API_KEY=

# 首次部署建议 true；数据库已有数据且不想每次启动检查初始化时可改 false。
RUN_DB_INIT=true
